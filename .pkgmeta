package-as: ShadowWordDeathExecute

# Keep the checked-in changelog in the packaged addon. This also makes the
# upload-only Packager pass reuse the already validated staging directory.
manual-changelog: CHANGELOG.md

move-folders:
  ShadowWordDeathExecute/ShadowWordDeathExecute: ShadowWordDeathExecute

ignore:
  - .agents
  - .codex
  - .git
  - .gitattributes
  - .github
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - README.md
  - README.ru.md
  - distribution
  - docs
  - scripts
  - stylua.toml
  - tests
