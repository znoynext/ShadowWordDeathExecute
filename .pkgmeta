package-as: ShadowWordDeathExecute

move-folders:
  ShadowWordDeathExecute/ShadowWordDeathExecute: ShadowWordDeathExecute

ignore:
  - .agents
  - .codex
  - .git
  - .gitattributes
  - .github
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - README.md
  - README.ru.md
  - distribution
  - docs
  - scripts
  - stylua.toml
  - tests
